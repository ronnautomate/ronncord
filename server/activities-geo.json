Islândia","d":"Quase sem árvore, e o islandês tem þ e ð."},"JP":{"n":"Japão","d":"Dirige na esquerda, escrita japonesa, poste de concreto com fio embolado e muro acústico nas vias expressas."},"KR":{"n":"Coreia do Sul","d":"Escrita coreana (hangul, letras com bolinhas e traços) e prédio alto numerado."},"TW":{"n":"Taiwan","d":"Chinês tradicional, scooter por todo lado e dirige na direita."},"HK":{"n":"Hong Kong","d":"Dirige na esquerda, chinês e inglês juntos e prédio residencial gigantesco."},"TH":{"n":"Tailândia","d":"Escrita tailandesa (cheia de voltinhas), dirige na esquerda e templo de telhado pontudo."},"VN":{"n":"Vietnã","d":"Vietnamita usa letra latina com MUITO acento, mar de motos e casa estreita e alta."},"MY":{"n":"Malásia","d":"Dirige na esquerda, malaio nas placas (Jalan = rua) e muito verde tropical."},"SG":{"n":"Singapura","d":"Dirige na esquerda, tudo limpíssimo e verde, e prédios modernos."},"PH":{"n":"Filipinas","d":"Dirige na direita, jeepney (ônibus colorido) e inglês nas placas."},"IN":{"n":"Índia","d":"Dirige na esquerda, escrita indiana (devanágari) com inglês e tuk-tuk verde e amarelo."},"NP":{"n":"Nepal","d":"Escrita devanágari, dirige na esquerda e montanha em volta de Katmandu."},"LK":{"n":"Sri Lanka","d":"Escrita cingalesa (letras redondinhas), dirige na esquerda e tuk-tuk."},"IL":{"n":"Israel","d":"Hebraico (escrito da direita pra esquerda), prédio cor de areia."},"GE":{"n":"Geórgia","d":"Alfabeto georgiano: letras todas arredondadas, parece nenhum outro."},"EG":{"n":"Egito","d":"Árabe, prédio de tijolo inacabado cor de areia e deserto."},"MA":{"n":"Marrocos","d":"Árabe e francês juntos, e construção cor de terra ou rosa."},"TN":{"n":"Tunísia","d":"Árabe e francês, casa branca com porta e janela azul."},"SN":{"n":"Senegal","d":"Francês nas placas, areia na beira da rua e calor."},"KE":{"n":"Quênia","d":"Dirige na esquerda, inglês e suaíli, e terra vermelha."},"UG":{"n":"Uganda","d":"Dirige na esquerda, terra vermelha e moto-táxi (boda-boda)."},"MG":{"n":"Madagascar","d":"Francês e malgaxe, terra vermelha e morro com arrozal."},"AU":{"n":"Austrália","d":"Dirige na esquerda, eucalipto por todo lado e placa amarela de losango."},"NZ":{"n":"Nova Zelândia","d":"Dirige na esquerda, morro verde e nome de lugar em maori."}}}